# O repositorio e editado no Windows (core.autocrlf=true), mas SQL e os arquivos de
# configuracao da pasta infra/ sao lidos por psql e pelo Postgres. Fixar LF aqui evita
# erros de parse que so aparecem no servidor.
*.sql           text eol=lf
*.conf          text eol=lf
infra/**        text eol=lf

# Binarios: nunca normalizar.
*.xlsx          binary
*.xlsm          binary
*.pbix          binary
*.pbids         binary
*.png           binary
*.pdf           binary
