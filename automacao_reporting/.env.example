# Copie para .env nesta pasta e preencha com valores reais.
# NUNCA versionar o .env (mesma regra do .env.example da raiz do projeto).

# --- n8n --------------------------------------------------------------------
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=defina-uma-senha-forte
# String aleatoria longa e FIXA (gere uma vez e nao troque depois -- trocar
# invalida todas as credenciais ja salvas dentro do n8n).
N8N_ENCRYPTION_KEY=gere-uma-string-aleatoria-longa
# Base da Redirect URL do OAuth2 do Outlook (secao 7 do README), que precisa
# bater com a URI cadastrada no Azure. Administrando o n8n pelo navegador da
# propria VM, deixe em localhost: o Azure recusa redirect URI em HTTP, mas abre
# excecao para localhost, entao esse e o caminho mais curto e o unico que nao
# exige publicar a porta do n8n.
WEBHOOK_URL=http://localhost:5678/

# --- Servico de captura (Playwright) -----------------------------------------
CAPTURE_API_KEY=gere-uma-chave-aleatoria

# --- Evolution API (WhatsApp) ------------------------------------------------
EVOLUTION_API_KEY=gere-uma-chave-aleatoria
EVOLUTION_DB_PASSWORD=defina-uma-senha-para-o-banco-interno-do-evolution

# --- Postgres de producao (fora desta stack) ---------------------------------
# IP DESTA VM na rede da empresa -- o Postgres roda no Windows dela, mas fora
# do WSL, entao os containers precisam alcanca-lo por um endereco de rede de
# verdade. Vira o apelido "pafil-db" no container do n8n (docker-compose.yml).
#
# Use o IP da LAN, e nao o IP interno do WSL: o interno muda a cada reinicio da
# distro, e uma automacao que para depois de todo reboot, sem erro visivel, e
# pior do que uma que nunca funcionou. Se a VM pega IP por DHCP, vale reservar
# o endereco no servidor DHCP.
#
# Confira com `nc -vz <ip> 5432` a partir do WSL antes de subir a stack -- se
# este valor estiver errado, o erro aparece so la na frente, como timeout na
# credencial de Postgres do n8n, que nao diz nada sobre a causa.
PG_HOST_IP=10.0.0.20

# Senha do role pafil_n8n, criada por sql/grants_reporting.sql. Fica aqui so
# como registro para quem for preencher a credencial dentro do n8n -- a stack
# em si nao le esta variavel (o n8n guarda a credencial criptografada, com a
# N8N_ENCRYPTION_KEY acima).
PG_N8N_PASSWORD=a-mesma-senha-usada-no-grants_reporting.sql
